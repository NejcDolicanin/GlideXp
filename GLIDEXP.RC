//Microsoft Developer Studio generated resource script.
//
#define OFFICIAL   1 
#define FINAL      1 

#include "swlibs/fxmisc/fxver.h"
#include "gxpVer.h"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//
VS_VERSION_INFO VERSIONINFO	
 FILEVERSION MAJVERSION, MAJREVISION, MINREVISION, BUILD_NUMBER
 PRODUCTVERSION MAJVERSION, MAJREVISION, MINREVISION, BUILD_NUMBER
 FILEFLAGSMASK 0x0030003FL
 FILEFLAGS (VER_PRIVATEBUILD|VER_PRERELEASE|VER_DEBUG)

 FILEOS VOS_DOS_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_INSTALLABLE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription", GLIDEXP " DLL" DEBUGSTR "\0"
            VALUE "FileVersion", VERSIONSTR	
            VALUE "InternalName", VERSIONNAME
            VALUE "LegalCopyright", "Copyright \251 2003 Ryan Nunn\0"
            VALUE "OriginalFilename", VERSIONNAME
            VALUE "ProductName", PRODNAME
            VALUE "ProductVersion", VERSIONSTR
            VALUE "Graphics Subsystem", HWSTR
            VALUE "Website", "http://www.users.on.net/triforce/glidexp/\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        /* the following line should be extended for localized versions */
        VALUE "Translation", 0x409, 1252
    END
END
